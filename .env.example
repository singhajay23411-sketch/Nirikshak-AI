# ==============================================================================
# Nirikshak AI — Environment Variables Configuration
# ==============================================================================

# Backend Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Assistant Precomputed Analytics Data Directory
NIRIKSHAK_DATA_DIR=frontend/public/data

# Assistant Mode (deterministic | llm)
ASSISTANT_MODE=deterministic

# Optional Server-Side LLM Configuration (never exposed to frontend)
ASSISTANT_LLM_PROVIDER=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_TIMEOUT=10
